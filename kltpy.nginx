# Not in use: kltpy.com's DNS points straight at Railway (custom domain in
# Railway's dashboard), so this nginx layer is out of the request path.
# The caching, Discord-UA gate, and static fallback it used to provide now
# live in the Express app (src/index.ts) instead. Keeping this file around
# only in case self-hosting nginx in front is reintroduced later.
proxy_cache_path  /data/nginx/cache  levels=1:2    keys_zone=STATIC:16m    inactive=24h  max_size=8g;

server {
    server_name kltpy.com c.kltpy.com;

    charset UTF-8;
    root /var/www/kltpy.com;

    location @fallback {
        if ($http_user_agent ~* "(Intel Mac OS X 11.6; rv:92.0|Discord)") {
            rewrite ^ /discord_sit.png break;
        }
    }

    location / {
        # Cache
        proxy_buffering        on;
        proxy_cache            STATIC;
        proxy_cache_valid      200  1d;
        proxy_cache_use_stale  error timeout invalid_header updating
                               http_500 http_502 http_503 http_504;

        # Request from Discord
        if ($http_user_agent ~* "(Intel Mac OS X 11.6; rv:92.0|Discord)") {
            error_page 502 = @fallback;
            # Replace with your actual Railway-issued domain (Settings > Networking > Public Networking)
            proxy_pass https://REPLACE-WITH-YOUR-APP.up.railway.app;
            proxy_set_header Host REPLACE-WITH-YOUR-APP.up.railway.app;
            proxy_ssl_server_name on;
        }

        # Request from anyone else
        if ($http_user_agent !~* "(Intel Mac OS X 11.6; rv:92.0|Discord)") {
            return 301 https://www.youtube.com/watch?v=km8CR-fdB7o;
        }
    }
    listen 443 ssl;

    # Certificate stuff here
}

server {
    if ($host = kltpy.com) {
        return 301 https://$host$request_uri;
    }

    listen 80 ;
    server_name kltpy.com;
}
